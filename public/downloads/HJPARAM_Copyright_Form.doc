<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
<meta charset="utf-8">
<title>HJPARAM Copyright Transfer & Author Declaration Agreement</title>
<!--[if gte mso 9]>
<xml>
<w:WordDocument>
<w:View>Print</w:View>
<w:Zoom>100</w:Zoom>
<w:DoNotOptimizeForBrowser/>
<w:Compatibility>
<w:BreakWrappedTables/>
<w:SnapToGridInCell/>
<w:WrapTextWithPunct/>
<w:UseAsianBreakRules/>
</w:Compatibility>
</w:WordDocument>
</xml>
<![endif]-->
<style>
@page {
    size: 21.0cm 29.7cm; /* A4 Portrait */
    margin: 1.0cm 1.4cm 0.8cm 1.4cm;
    mso-page-orientation: portrait;
}
@page Section1 {
    size: 21.0cm 29.7cm;
    margin: 1.0cm 1.4cm 0.8cm 1.4cm;
    mso-header-margin: 0.4cm;
    mso-footer-margin: 0.4cm;
}
div.Section1 {
    page: Section1;
}
body {
    font-family: 'Times New Roman', Times, serif;
    font-size: 8.5pt;
    line-height: 1.2;
    color: #0f172a;
    margin: 0;
    padding: 0;
}
/* Header */
.header-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 6pt;
    border-bottom: 2pt solid #0f2b5c;
    padding-bottom: 4pt;
}
.header-table td {
    vertical-align: middle;
    padding: 0;
}
.pub-name {
    font-size: 15pt;
    font-weight: bold;
    color: #0f2b5c;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0;
}
.form-title {
    font-size: 10.5pt;
    font-weight: bold;
    color: #1e3a8a;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 2pt 0 0 0;
}
.meta-right {
    text-align: right;
    font-size: 7.5pt;
    color: #475569;
    line-height: 1.25;
}
/* Notice Box */
.notice-box {
    background-color: #f8fafc;
    border: 0.5pt solid #cbd5e1;
    border-left: 2.5pt solid #0f2b5c;
    padding: 3pt 6pt;
    font-size: 7.5pt;
    color: #334155;
    margin-bottom: 6pt;
    line-height: 1.2;
}
/* Manuscript Info Table */
table.info-tbl {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 6pt;
}
table.info-tbl td {
    border: 0.5pt solid #94a3b8;
    padding: 2.5pt 4pt;
    font-size: 8pt;
    vertical-align: middle;
}
table.info-tbl td.lbl {
    background-color: #f1f5f9;
    font-weight: bold;
    color: #0f172a;
    width: 22%;
    white-space: nowrap;
}
/* Section Headers */
.sec-hdr {
    background-color: #0f2b5c;
    color: #ffffff;
    font-size: 8pt;
    font-weight: bold;
    padding: 2pt 5pt;
    margin-top: 5pt;
    margin-bottom: 3pt;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}
/* Terms 2-Column Table */
table.terms-tbl {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 5pt;
}
table.terms-tbl td {
    vertical-align: top;
    padding: 0 4pt;
    font-size: 7.5pt;
    line-height: 1.2;
    text-align: justify;
}
.term-item {
    margin-bottom: 3pt;
}
.term-item strong {
    color: #0f172a;
}
/* Signature Table */
table.sign-tbl {
    width: 100%;
    border-collapse: collapse;
    margin-top: 4pt;
    margin-bottom: 4pt;
}
table.sign-tbl th {
    background-color: #f1f5f9;
    border: 0.5pt solid #64748b;
    padding: 3pt 4pt;
    font-size: 8pt;
    font-weight: bold;
    color: #0f172a;
    text-align: left;
}
table.sign-tbl td {
    border: 0.5pt solid #94a3b8;
    padding: 3pt 4pt;
    font-size: 7.5pt;
    vertical-align: middle;
    height: 18pt;
}
/* Footer */
.footer-text {
    text-align: center;
    font-size: 7pt;
    color: #64748b;
    margin-top: 4pt;
    border-top: 0.5pt solid #e2e8f0;
    padding-top: 3pt;
}
</style>
</head>
<body>

<div class="Section1">

    <!-- Header -->
    <table class="header-table">
        <tr>
            <td style="width: 65%;">
                <div class="pub-name">HJPARAM PUBLICATION</div>
                <div class="form-title">COPYRIGHT TRANSFER &amp; AUTHOR DECLARATION AGREEMENT</div>
            </td>
            <td style="width: 35%;" class="meta-right">
                <strong>Open Access Publishing</strong> (CC BY 4.0)<br>
                Official Editorial Ethics &amp; Legal Assignment<br>
                Web: www.hjparam.com | Email: editorial@hjparam.com
            </td>
        </tr>
    </table>

    <!-- Notice -->
    <div class="notice-box">
        <strong>Mandatory Submission Requirement:</strong> All authors must be listed below. All authors may sign individually, or the corresponding author may sign on behalf of all co-authors with their explicit written consent. Please upload the completed, signed copy via the online submission portal.
    </div>

    <!-- Manuscript Metadata Table -->
    <table class="info-tbl">
        <tr>
            <td class="lbl">Manuscript Title:</td>
            <td colspan="3" style="font-weight: bold; height: 16pt;">&nbsp;</td>
        </tr>
        <tr>
            <td class="lbl">Manuscript Tracking ID:</td>
            <td style="width: 28%;">&nbsp;</td>
            <td class="lbl" style="width: 20%;">Target Journal:</td>
            <td style="width: 30%;">&nbsp;</td>
        </tr>
        <tr>
            <td class="lbl">Corresponding Author:</td>
            <td>Name:</td>
            <td class="lbl">Official Email:</td>
            <td>&nbsp;</td>
        </tr>
        <tr>
            <td class="lbl">Author Affiliation:</td>
            <td colspan="3">Department / University / Institution:</td>
        </tr>
        <tr>
            <td class="lbl">Names of All Co-Authors:</td>
            <td colspan="3">1. ______________________ &nbsp; 2. ______________________ &nbsp; 3. ______________________ &nbsp; 4. ______________________</td>
        </tr>
    </table>

    <!-- Section A & B Grid -->
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 2pt;">
        <tr>
            <td style="width: 50%; vertical-align: top; padding-right: 4pt;">
                <div class="sec-hdr">PART A: WARRANTIES OF ORIGINALITY &amp; ETHICS</div>
                <div class="term-item">
                    <strong>1. Original Work:</strong> The manuscript represents an original, unplagiarized study, has not been published elsewhere, and is not currently under review with any other journal or conference proceedings.
                </div>
                <div class="term-item">
                    <strong>2. Authorship Integrity:</strong> All authors listed qualify under ICMJE criteria, contributed directly to the research, and approved the final submitted draft. No ghost or gift authors are included.
                </div>
                <div class="term-item">
                    <strong>3. Data Authenticity:</strong> Figures, tables, and experimental findings are genuine and unmanipulated. Proper citations and permissions have been obtained for any copyrighted excerpts.
                </div>
                <div class="term-item">
                    <strong>4. Ethical Approvals:</strong> Studies involving human participants or animal welfare secured prior approval from the Institutional Review Board (IRB) / Ethics Committee, adhering to Helsinki/ARRIVE guidelines.
                </div>
                <div class="term-item">
                    <strong>5. Conflict Disclosure:</strong> All financial assistance, grants, and commercial conflicts of interest are disclosed in the manuscript text.
                </div>
            </td>
            <td style="width: 50%; vertical-align: top; padding-left: 4pt;">
                <div class="sec-hdr">PART B: COPYRIGHT &amp; CC BY 4.0 OPEN ACCESS</div>
                <div class="term-item">
                    <strong>1. Author Copyright Retention:</strong> Authors retain full, unrestricted intellectual copyright and patent rights over their published manuscript.
                </div>
                <div class="term-item">
                    <strong>2. Non-Exclusive License:</strong> Authors grant HJPARAM Publication a perpetual, worldwide, non-exclusive license to publish, archive, index, and distribute the Version of Record.
                </div>
                <div class="term-item">
                    <strong>3. Creative Commons (CC BY 4.0):</strong> The article is published under CC BY 4.0 terms, permitting anyone to read, copy, adapt, and build upon the work with proper attribution.
                </div>
                <div class="term-item">
                    <strong>4. Self-Archiving Freedom:</strong> Authors retain the right to self-archive preprints, accepted manuscripts, and the published PDF in institutional repositories with zero embargo.
                </div>
                <div class="term-item">
                    <strong>5. Legal Indemnity:</strong> Authors confirm that the paper contains no defamatory, unlawful, or copyright-infringing content.
                </div>
            </td>
        </tr>
    </table>

    <!-- Section C: Signatures -->
    <div class="sec-hdr">PART C: AUTHOR SIGNATURE &amp; DECLARATION ACCEPTANCE</div>
    <div style="font-size: 7.5pt; color: #334155; margin-bottom: 2pt;">
        By signing below, I/we certify that all information provided is accurate and agree to all terms of this agreement on behalf of all authors.
    </div>

    <table class="sign-tbl">
        <thead>
            <tr>
                <th style="width: 25%;">Author Full Name (Printed)</th>
                <th style="width: 32%;">Designation &amp; Institution</th>
                <th style="width: 25%;">Signature / E-Signature</th>
                <th style="width: 18%;">Date (DD/MM/YYYY)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1. (Corresponding Author)</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td>2.</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td>3.</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td>4.</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
            </tr>
        </tbody>
    </table>

    <div class="footer-text">
        HJPARAM Publication • Official Open Access Copyright Agreement • Form Version 2.4 • Retain a signed copy for your institutional records
    </div>

</div>

</body>
</html>
