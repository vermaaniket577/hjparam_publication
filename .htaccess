<IfModule mod_rewrite.c>
    RewriteEngine On

    # Stop processing if the requested file or directory already exists
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite empty root to public/index.php
    RewriteRule ^$ public/index.php [L]

    # Rewrite any non-public request into public/ (preventing recursion)
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>
